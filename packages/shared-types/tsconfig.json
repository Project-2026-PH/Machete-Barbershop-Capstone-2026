{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "lib": ["ES2022"],
    "strict": true,
    "noImplicitOverride": true,
    "incremental": true,
    "tsBuildInfoFile": "./node_modules/.cache/typescript/shared-types.tsbuildinfo",
    "moduleResolution": "bundler",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": ["index.ts", "payment-recipient.ts", "payment-providers.ts", "profanity-filter.ts", "supabase.ts"]
}
